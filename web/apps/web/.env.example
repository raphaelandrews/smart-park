# Base URL of the Spring API.
# Dev: "/api" is proxied by Vite to http://localhost:8080 (see vite.config.ts).
# Prod: use the API subdomain, e.g. https://api.yourdomain.com
VITE_API_URL=/api

# Google OAuth Web Client ID (Google Identity Services).
# Leave empty to hide the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
