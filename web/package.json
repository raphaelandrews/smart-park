{
  "name": "web",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^6.0.3",
      "@types/node": "^26.6.6",
      "varlock": "1.25.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:web": "bun run --filter web dev:bare",
    "deploy": "bun run --filter @web/infra deploy",
    "destroy": "bun run --filter @web/infra destroy",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@tanstack/intent": "^0.5.6",
    "@types/node": "catalog:",
    "@web/config": "workspace:*",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.13",
  "intent": {
    "skills": [
      "@tanstack/react-router#react-router",
      "@tanstack/react-router#compositions/router-query",
      "@tanstack/router-plugin#router-plugin",
      "@tanstack/router-core#router-core/auth-and-guards",
      "@tanstack/router-core#router-core/data-loading",
      "@tanstack/router-core#router-core/navigation",
      "@tanstack/router-core#router-core/not-found-and-errors",
      "@tanstack/router-core#router-core/search-params",
      "@tanstack/router-core#router-core/type-safety",
      "varlock#varlock"
    ],
    "exclude": [
      "@tanstack/react-router#lifecycle/migrate-from-react-router"
    ]
  }
}
