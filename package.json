{
  "name": "smart-park",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "cd api && ./mvnw spring-boot:run",
    "dev:web": "cd web && bun run dev:web",
    "build": "bun run build:api && bun run build:web",
    "build:api": "cd api && ./mvnw -DskipTests package",
    "build:web": "cd web && bun run build",
    "lint": "cd web && bunx oxlint",
    "test": "cd api && ./mvnw test",
    "gen:api": "cd web/apps/web && bun run gen:api"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
